	delay100us();
	delay100us();
	delay100us();
	delay100us();
	delay100us();
	delay100us();
	delay100us();
	delay100us();
	delay100us();
	delay100us();
}

void delay100us(){
	delayTIM3us(10);
	delay10us();
	delayTIM3us(10);
	delay10us();
	delayTIM3us(10);
	delay10us();
	delayTIM3us(10);
	delay10us();
	delayTIM3us();
	delay10us();
}

void delayTIM3ms(short ms){
	for(int i = 0; i < ms; i++)
		delay1ms();
}
/**
  * @brief System Clock Configuration
  * @retval None
  */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  /** Initializes the RCC Oscillators according to the specified parameters
  * in the RCC_OscInitTypeDef structure.
  */
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSI;
  RCC_OscInitStruct.HSIState = RCC_HSI_ON;
  RCC_OscInitStruct.HSICalibrationValue = RCC_HSICALIBRATION_DEFAULT;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_NONE;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
  {
    Error_Handler();
  }

  /** Initializes the CPU, AHB and APB buses clocks
  */
  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK
                              |RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_HSI;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV1;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV1;

  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_0) != HAL_OK)
  {
    Error_Handler();
  }
}

/**
  * @brief GPIO Initialization Function
  * @param None
  * @retval None
  */
static void MX_GPIO_Init(void)
{
  GPIO_InitTypeDef GPIO_InitStruct = {0};
  /* USER CODE BEGIN MX_GPIO_Init_1 */

  /* USER CODE END MX_GPIO_Init_1 */

  /* GPIO Ports Clock Enable */
  __HAL_RCC_GPIOC_CLK_ENABLE();
  __HAL_RCC_GPIOA_CLK_ENABLE();

  /*Configure GPIO pin Output Level */
  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13, GPIO_PIN_RESET);

  /*Configure GPIO pin : PC13 */
  GPIO_InitStruct.Pin = GPIO_PIN_13;
  GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  GPIO_InitStruct.Pull = GPIO_NOPULL;
  GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);

  /* USER CODE BEGIN MX_GPIO_Init_2 */

  /* USER CODE END MX_GPIO_Init_2 */
}

/* USER CODE BEGIN 4 */

//Savotikov

void EXTI3_Interrupt_Innit(){
	EXTI3_Innit();
}

void EXTI3_Innit(){
	RCC->APB2ENR |= 1;

	AFIO->EXTICR[0] &= ~(0b1111 << 12);
	AFIO->EXTICR[0] |= (0b0001 << 12);

	EXTI->FTSR |= (1 << 3);
	EXTI->RTSR &= ~(1 << 3);

	GPIOB->ODR |= (1 << 3);

	EXTI->IMR |= (1 << 3);

	NVIC->ISER[0] |= (1 << 9);
}

void CaptureCompareInnit(){
	PA0_PA1_InputInnit();
	TIM2_CaptureCompareInnit();
}

void PA0_PA1_InputInnit(){
	//PA0 - echo

	//PA0 input
	GPIOA->CRL &= ~(0b1111);
	GPIOA->CRL |= (0b0100);

	//PA1 input
	GPIOA->CRL &= ~(0b1111 << 4);
	GPIOA->CRL |= (0b1000 << 4);

	GPIOA->ODR &= ~1;
}

void TIM2_CaptureCompareInnit(){

	TIM2BaseSettings();

	CCMR1_Chanel1Innit();
	CCMR1_Chanel2Innit();

	CCER_PolarityCaptureInnit_TI1();
	CCER_PolarityCaptureInnit_TI2();

	TIM2InterruptEnable();

	TIM2->EGR = 1; //Update event
	TIM2->CR1 |= 1;
}

void TIM2InterruptEnable(){
	TIM2->DIER |= (1 << 1) | (1 << 2);

	NVIC->ISER[0] |= (1 << 28);
}

void CCMR1_Chanel1Innit(){
	TIM2->CCMR1 &= ~(0b11);
	TIM2->CCMR1 |= (0b01); //CC on TI

	// PSC
	TIM2->CCMR1 &= ~(0b11 << 2);

	//Input filter
	TIM2->CCMR1 &= ~(0b1111 << 4);
	TIM2->CCMR1 |= (0b0001 << 4);
}

void CCMR1_Chanel2Innit(){
	TIM2->CCMR1 &= ~(0b11 << 8);
	TIM2->CCMR1 |= (0b10 << 8); //CC on TI

	// PSC
	TIM2->CCMR1 &= ~(0b11 << 10);

	//Input filter
	TIM2->CCMR1 &= ~(0b1111 << 12);
	TIM2->CCMR1 |= (0b1111 << 12);
}

void CCER_PolarityCaptureInnit_TI1(){
	TIM2->CCER |= 1;
	TIM2->CCER &= ~(1 << 1);
}

void CCER_PolarityCaptureInnit_TI2(){
	TIM2->CCER |= (1 << 4);
	TIM2->CCER |= (1 << 5);
}

void TIM2BaseSettings(){
	RCC->APB1ENR |= 1; //TIM2

	TIM2->CNT = 0;
	TIM2->PSC = 7;
	TIM2->ARR = 65535;
}

void RCC_PA_Innit(){
	RCC->APB2ENR |= (1 << 2); //Port 2 clock enable

	GPIOA->CRL &= ~(0b1111 << 8);
	GPIOA->CRL |= (0b0011 << 8);

	GPIOA->CRL &= ~(0b1111 << 12);
	GPIOA->CRL |= (0b0011 << 12);

	GPIOA->CRL &= ~(0b1111 << 16);
	GPIOA->CRL |= (0b0011 << 16);

	GPIOA->CRL &= ~(0b1111 << 20);
	GPIOA->CRL |= (0b0011 << 20);

	GPIOA->CRL &= ~(0b1111 << 24);
	GPIOA->CRL |= (0b0011 << 24);

	GPIOA->CRL &= ~(0b1111 << 28);
	GPIOA->CRL |= (0b0011 << 28);

	GPIOA->CRH &= ~(0b1111);
	GPIOA->CRH |= (0b0011);

	GPIOA->CRH &= ~(0b1111 << 4);
	GPIOA->CRH |= (0b0011 << 4);

	GPIOA->CRH &= ~(0b1111 << 8);
	GPIOA->CRH |= (0b0011 << 8);

	GPIOA->CRH &= ~(0b1111 << 12);
	GPIOA->CRH |= (0b0011 << 12);

	GPIOA->CRH &= ~(0b1111 << 16);
	GPIOA->CRH |= (0b0011 << 16);

}

void PB_Innit(){
	RCC->APB2ENR |= (1 << 3); //PB clock enable

	GPIOB->CRL &= ~(0b1111 << 12); //PB3
	GPIOB->CRL |= (0b1000 << 12);

	GPIOB->CRL &= ~(0b1111 << 8); //PB2
	GPIOB->CRL |= (0b0010 << 8);

	GPIOB->CRL &= ~(0b1111); //PB0
	GPIOB->CRL |= (0b0011);

	GPIOB->CRH &= ~(0b1111 << 8); // PB10
	GPIOB->CRH |= (0b1000 << 8);

	GPIOB->ODR &= ~(1);
	GPIOB->ODR &= ~(1 << 2);
	//TRIG - PB0
	//Interrupt - PB10
}

void PC_Innit(){
	RCC->APB2ENR |= (1 << 4); //PC clock enable

	//C13 output
	GPIOC->CRH &= ~(0b1111 << 20);
	GPIOC->CRH |= (0b0011 << 20);


}

void Delay10usInnit(){

	RCC->APB1ENR |= (1 << 1); //TIM3

	TIM3->CNT = 0;
	TIM3->PSC = 0;
	TIM3->ARR = 100;

	TIM3->EGR = 1;

}

void delay10us(){

	RCC->APB1ENR |= (1 << 1); //TIM3

	TIM3->CNT = 0;
	TIM3->PSC = 0;
	TIM3->ARR = 100;

	TIM3->EGR = 1;

	TIM3->SR = 0;
	TIM3->CR1 |= 1;

	while(!TIM3->SR);

	TIM3->CR1 &= ~1;
}

void delayTIM3us(short us_)
{
	TIM3->ARR = us_ * 10;
	TIM3->EGR = 1;

	TIM3->SR = 0;
	TIM3->CR1 |= 1;

	while(!TIM3->SR);

	TIM3->CR1 &= ~1;
}

void EXTI3_IRQHandler(void){

	if(EXTI->PR & (0b1 << 3)){

		delay10ms();
		delay10ms();
		delay10ms();
		delay10ms();
		delay10ms();
		delay10ms();
		delay10ms();
		delay10ms();
		delay10ms();
		delay10ms();

		GPIOB->BSRR = 1;
		delay10us();
		GPIOB->BSRR = (1 << 16);

		EXTI->PR = (1 << 3);
		//outputDis();
	}
}


void startCountTIM4(){
	TIM4->SR &= ~1;
	TIM4->CR1 |= 1;
	countingTIM4 = 1;
}

void TIM2_IRQHandler(void){
    // Проверяем CC1IF
	quantity++;

    if(TIM2->SR & (1 << 1)){
        startCapture = TIM2->CCR1;
       //TIM2->SR &= ~TIM_SR_CC1IF;  // Очищаем правильный флаг
    }
    // Проверяем CC2IF
    if(TIM2->SR & (1 << 2)){
        endCapture = TIM2->CCR2;    // Берем CCR2!
        result = endCapture - startCapture;
        short quantityEteration = result /1000;
        for (int i = 0; i < quantityEteration; i++){
        	GPIOB->ODR |= (1 << 2);
        	delay100ms();
        	delay100ms();
        	delay100ms();
        	GPIOB->ODR &= ~(1 << 2);
        	delay100ms();
        	delay100ms();
        	delay100ms();
        }


    }
}

